{
  "cases": ["mutation-question-base", "mutation-question-assertion"],
  "models": ["gpt-oss:120b-cloud"],
  "representations": ["pipe-v3"],
  "transformations": ["identity"],
  "reasoning": ["low"],
  "seeds": [1, 2, 3, 4, 5],
  "promptVersion": "v1",
  "mutations": [
    {
      "id": "question-to-assertion",
      "baselineCase": "mutation-question-base",
      "mutantCase": "mutation-question-assertion",
      "baselineExpect": {
        "matchedOpenQuestionIds": ["website-availability.question"],
        "absentForbiddenIds": ["website-unavailable.assertion"],
        "maxFalseOpenQuestionRate": 0
      },
      "mutantExpect": {
        "matchedClaimIds": ["website-unavailable.assertion"],
        "maxFalseOpenQuestionRate": 0
      }
    }
  ]
}
