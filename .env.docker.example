# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

STORAGE_MODE=postgres
MODELS_MODE=openai-compatible

# OpenRouter is the default OpenAI-compatible provider.
# Either OPENROUTER_TOKEN or LLM_API_KEY can be used.
OPENROUTER_TOKEN=

# Set to production to route Ollama requests across cheap/default/quality tiers.
LLM_ROUTER_MODE=disabled
LLM_ROUTER_CHEAP_MODEL=gpt-oss:20b
LLM_ROUTER_DEFAULT_MODEL=qwen3.5:9b
LLM_ROUTER_QUALITY_MODEL=deepseek-v4-pro:cloud
LLM_ROUTER_DEFAULT_MIN_INPUT_TOKENS=2000
LLM_ROUTER_QUALITY_MIN_INPUT_TOKENS=12000
LLM_ROUTER_FAILURE_THRESHOLD=3
LLM_ROUTER_CIRCUIT_COOLDOWN_MS=30000
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Leave DATABASE_URL empty to let compose point the bot at the postgres service.
# Set it only when using an external Postgres database.
DATABASE_URL=

# Use one fixed model, or leave empty and use the fallback list in compose.yaml.
LLM_MODEL=
LLM_MODELS=
LLM_MERGE_MODEL=openrouter/free
LLM_MEMORY_MODEL=gpt-oss:120b-cloud
LLM_QUARANTINE_MODELS=

# Local Postgres container settings.
POSTGRES_DB=microsonya
POSTGRES_USER=microsonya
POSTGRES_PASSWORD=microsonya
POSTGRES_PORT=5432
