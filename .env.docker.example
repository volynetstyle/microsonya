# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

STORAGE_MODE=memory
MEMORY_FILE_PATH=/app/data/memory.json
MODELS_MODE=enabled

# All model configuration below is read in exactly one place:
# packages/model-gateway/src/modelConfig.ts. Every value here documents that
# module's env vars and defaults (see that file for the source of truth).
#
# Default transport is a local native Ollama server. Inside the container,
# "localhost" is the container itself, so this points at the host's Ollama
# via Docker Desktop's host.docker.internal. On native Linux Docker, either
# run Ollama in a compose service instead, or add
# `extra_hosts: ["host.docker.internal:host-gateway"]` to compose.yaml.
LLM_BASE_URL=http://host.docker.internal:11434

# How structured (schema-constrained) generation talks to the endpoint:
# ollama-native uses Ollama's own JSON mode; openai-compatible uses the
# generic client. Explicit, not guessed from LLM_BASE_URL — switch it
# together with LLM_BASE_URL when changing providers.
LLM_STRUCTURED_TRANSPORT=ollama-native

# Only required when LLM_BASE_URL is not a local endpoint.
# Either OPENROUTER_TOKEN or LLM_API_KEY can be used.
OPENROUTER_TOKEN=
LLM_API_KEY=

# Leave DATABASE_URL empty to let compose point the bot at the postgres service.
# Set it only when using an external Postgres database.
DATABASE_URL=

# Use one fixed model, or leave empty to use the default.
LLM_MODEL=
LLM_MODELS=
LLM_MERGE_MODEL=
LLM_MEMORY_MODEL=gpt-oss:20b-cloud
LLM_QUARANTINE_MODELS=

# Local Postgres container settings.
POSTGRES_DB=microsonya
POSTGRES_USER=microsonya
POSTGRES_PASSWORD=microsonya
POSTGRES_PORT=5432
