{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "microsonya-cloudflare",
  "main": "../../src/ingress/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BOT_USERNAME": "MicrosonyaBot",
  },
  "secrets": {
    "required": ["TELEGRAM_WEBHOOK_SECRET", "MICROSONYA_DATA_ENCRYPTION_KEY"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgresql://microsonya:microsonya@localhost:5432/microsonya",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "microsonya_runs",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SUMMARY_JOBS",
        "queue": "microsonya-summary-runs",
      },
    ],
    "consumers": [
      {
        "queue": "microsonya-summary-runs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "microsonya-summary-runs-dlq",
      },
    ],
  },
  "services": [
    {
      "binding": "SUMMARY_RUNS",
      "service": "microsonya-summary-runs",
      "entrypoint": "SummaryRunsEntrypoint",
    },
    {
      "binding": "SUMMARY_PROCESSOR",
      "service": "microsonya-summary-processor",
      "entrypoint": "SummaryProcessorEntrypoint",
    },
  ],
}
