{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "microsonya-summary-processor",
  "main": "../../src/processor/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROCESSOR_VERSION": "0.1.0",
    "OLLAMA_BASE_URL": "https://ollama.com/api",
  },
  "secrets": {
    "required": [
      "MICROSONYA_DATA_ENCRYPTION_KEY",
      "OLLAMA_API_KEY",
      "TELEGRAM_BOT_TOKEN",
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgresql://microsonya:microsonya@localhost:5432/microsonya",
    },
  ],
  "services": [
    {
      "binding": "SUMMARY_RUNS",
      "service": "microsonya-summary-runs",
      "entrypoint": "SummaryRunsEntrypoint",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "microsonya_runs",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
