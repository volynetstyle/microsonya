{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "microsonya-staging-summary-processor",
  "main": "../../src/processor/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROCESSOR_VERSION": "0.1.1-staging",
    "OLLAMA_BASE_URL": "https://ollama.com/api",
  },
  "secrets": {
    "required": [
      "MICROSONYA_DATA_ENCRYPTION_KEY",
      "OLLAMA_API_KEY",
      "TELEGRAM_BOT_TOKEN",
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d2c145ca49e4254861ff56a9e4a93b5",
      "localConnectionString": "postgresql://microsonya:microsonya@localhost:5432/microsonya",
    },
  ],
  "services": [
    {
      "binding": "SUMMARY_RUNS",
      "service": "microsonya-staging-summary-runs",
      "entrypoint": "SummaryRunsEntrypoint",
    },
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "microsonya_staging_runs" },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
