{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "microsonya-staging-summary-runs",
  "main": "../../src/lifecycle/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["MICROSONYA_DATA_ENCRYPTION_KEY"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d2c145ca49e4254861ff56a9e4a93b5",
      "localConnectionString": "postgresql://microsonya:microsonya@localhost:5432/microsonya",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "SUMMARY_JOBS", "queue": "microsonya-summary-runs-staging" },
    ],
  },
  "triggers": { "crons": ["*/1 * * * *"] },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "microsonya_staging_runs" },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
