{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "microsonya-summary-runs",
  "main": "../../src/lifecycle/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["MICROSONYA_DATA_ENCRYPTION_KEY"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgresql://microsonya:microsonya@localhost:5432/microsonya",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SUMMARY_JOBS",
        "queue": "microsonya-summary-runs",
      },
    ],
  },
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "microsonya_runs",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
