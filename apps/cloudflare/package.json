{
  "name": "@microsonya/cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:workers": "vitest run --config vitest.config.ts",
    "types": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler types --config wrangler.jsonc --config ../summary-runs/wrangler.jsonc --config ../summary-processor/wrangler.jsonc",
    "types:check": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler types --config wrangler.jsonc --config ../summary-runs/wrangler.jsonc --config ../summary-processor/wrangler.jsonc --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@microsonya/contracts": "workspace:*",
    "@microsonya/shared": "workspace:*",
    "@microsonya/telegram": "workspace:*",
    "@telegraf/types": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "wrangler": "^4.127.1"
  }
}
