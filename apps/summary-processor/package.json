{
  "name": "@microsonya/summary-processor-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler types --config wrangler.jsonc --config ../summary-runs/wrangler.jsonc",
    "types:check": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler types --config wrangler.jsonc --config ../summary-runs/wrangler.jsonc --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@microsonya/contracts": "workspace:*",
    "@microsonya/db": "workspace:*",
    "@microsonya/model": "workspace:*",
    "@microsonya/shared": "workspace:*",
    "@microsonya/summarize": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
