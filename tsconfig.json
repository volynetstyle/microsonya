{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@microsonya/shared": ["packages/shared/src/index.ts"],
      "@microsonya/model": ["packages/model/src/index.ts"],
      "@microsonya/db": ["packages/db/src/index.ts"],
      "@microsonya/summarize": ["packages/summarize/src/index.ts"]
    }
  },
  "include": [
    "test/**/*.ts",
    "research/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/telegram/bot/src/**/*.ts"
  ]
}
