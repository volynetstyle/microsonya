    "text": "Для експорту звітів потрібен CSV."
  },
  {
    "id": 2,
    "user": "B",
    "time": "09:01",
    "replyTo": 1,
    "text": "Додам експорт після виправлення авторизації."
  },
  {
    "id": 3,
    "user": "C",
    "time": "09:02",
    "text": "Хтось бачив новий трейлер?"
  },
  { "id": 4, "user": "D", "time": "09:03", "text": "Так, музика чудова." },
  { "id": 5, "user": "C", "time": "09:04", "text": "Піду по каву." },
  { "id": 6, "user": "D", "time": "09:05", "text": "Візьми мені чай." },
  { "id": 7, "user": "C", "time": "09:06", "text": "Сьогодні тепло." },
  { "id": 8, "user": "D", "time": "09:07", "text": "А ввечері буде дощ." },
  { "id": 9, "user": "C", "time": "09:08", "text": "Зустріч о третій." },
  { "id": 10, "user": "D", "time": "09:09", "text": "Я буду вчасно." },
  { "id": 11, "user": "C", "time": "09:10", "text": "У кухні є печиво." },
  { "id": 12, "user": "D", "time": "09:11", "text": "Дякую." },
  { "id": 13, "user": "C", "time": "09:12", "text": "Оновив аватар." },
  { "id": 14, "user": "D", "time": "09:13", "text": "Гарно." },
  { "id": 15, "user": "C", "time": "09:14", "text": "Пошта знову повільна." },
  { "id": 16, "user": "D", "time": "09:15", "text": "У мене працює." },
  { "id": 17, "user": "C", "time": "09:16", "text": "Хто замовляє обід?" },
  { "id": 18, "user": "D", "time": "09:17", "text": "Я вже замовив." },
  { "id": 19, "user": "C", "time": "09:18", "text": "Ліфт ремонтують." },
  { "id": 20, "user": "D", "time": "09:19", "text": "Піднімусь сходами." },
  { "id": 21, "user": "C", "time": "09:20", "text": "Нові стікери смішні." },
  { "id": 22, "user": "D", "time": "09:21", "media": "sticker" },
  {
    "id": 23,
    "user": "C",
    "time": "09:22",
    "text": "Зарядка лежить на столі."
  },
  { "id": 24, "user": "D", "time": "09:23", "text": "Заберу пізніше." },
  { "id": 25, "user": "C", "time": "09:24", "text": "На вулиці шумно." },
  { "id": 26, "user": "D", "time": "09:25", "text": "Це ремонт дороги." },
  { "id": 27, "user": "C", "time": "09:26", "text": "Завтра вихідний?" },
  { "id": 28, "user": "D", "time": "09:27", "text": "Ні, звичайний день." },
  {
    "id": 29,
    "user": "C",
    "time": "09:28",
    "text": "Кіт заснув на клавіатурі."
  },
  { "id": 30, "user": "D", "time": "09:29", "text": "Класика." },
  { "id": 31, "user": "C", "time": "09:30", "text": "Перерва закінчується." },
  { "id": 32, "user": "D", "time": "09:31", "text": "Повертаюсь до роботи." },
  {
    "id": 33,
    "user": "A",
    "time": "09:32",
    "replyTo": 2,
    "text": "Авторизацію вже виправили, тому беру CSV-експорт сьогодні."
  }
