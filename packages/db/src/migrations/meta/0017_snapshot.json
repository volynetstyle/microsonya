      "checkConstraints": {
        "summary_run_lifecycle_status_check": {
          "name": "summary_run_lifecycle_status_check",
          "value": "\"summary_run_lifecycle\".\"status\" in ('created', 'queued', 'processing', 'summary_ready', 'delivering', 'completed', 'retry_wait', 'failed_permanent')"
        },
        "summary_run_lifecycle_mode_check": {
          "name": "summary_run_lifecycle_mode_check",
          "value": "\"summary_run_lifecycle\".\"mode\" in ('recent', 'today', 'count')"
        },
        "summary_run_lifecycle_attempt_check": {
          "name": "summary_run_lifecycle_attempt_check",
          "value": "\"summary_run_lifecycle\".\"attempt\" >= 0"
        },
        "summary_run_lifecycle_delivery_attempt_check": {
          "name": "summary_run_lifecycle_delivery_attempt_check",
          "value": "\"summary_run_lifecycle\".\"delivery_attempt\" >= 0"
        },
        "summary_run_lifecycle_lease_check": {
          "name": "summary_run_lifecycle_lease_check",
          "value": "(\"summary_run_lifecycle\".\"status\" in ('processing', 'delivering') and \"summary_run_lifecycle\".\"lease_token\" is not null and \"summary_run_lifecycle\".\"lease_expires_at\" is not null) or (\"summary_run_lifecycle\".\"status\" not in ('processing', 'delivering') and \"summary_run_lifecycle\".\"lease_token\" is null and \"summary_run_lifecycle\".\"lease_expires_at\" is null)"
        },
        "summary_run_lifecycle_retry_stage_check": {
          "name": "summary_run_lifecycle_retry_stage_check",
          "value": "(\"summary_run_lifecycle\".\"status\" = 'retry_wait' and \"summary_run_lifecycle\".\"retry_stage\" in ('processing', 'delivery')) or (\"summary_run_lifecycle\".\"status\" = 'queued' and (\"summary_run_lifecycle\".\"retry_stage\" is null or \"summary_run_lifecycle\".\"retry_stage\" in ('processing', 'delivery'))) or (\"summary_run_lifecycle\".\"status\" not in ('retry_wait', 'queued') and \"summary_run_lifecycle\".\"retry_stage\" is null)"
        },
        "summary_run_lifecycle_delivery_summary_check": {
          "name": "summary_run_lifecycle_delivery_summary_check",
          "value": "(\"summary_run_lifecycle\".\"status\" not in ('summary_ready', 'delivering', 'completed') and \"summary_run_lifecycle\".\"retry_stage\" is distinct from 'delivery') or \"summary_run_lifecycle\".\"summary_ciphertext\" is not null"
        },
        "summary_run_lifecycle_count_check": {
          "name": "summary_run_lifecycle_count_check",
          "value": "(\"summary_run_lifecycle\".\"mode\" = 'count' and \"summary_run_lifecycle\".\"requested_count\" is not null and \"summary_run_lifecycle\".\"requested_count\" > 0) or (\"summary_run_lifecycle\".\"mode\" <> 'count' and \"summary_run_lifecycle\".\"requested_count\" is null)"
        }
      },
