{
  "name": "microsonya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "bundle:bot": "pnpm --filter @microsonya/telegram-bot build",
    "db:generate": "pnpm --filter @microsonya/db generate",
    "db:migrate": "pnpm --filter @microsonya/db migrate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f telegram-bot",
    "typecheck": "pnpm -r --filter \"./packages/**\" build && pnpm -r typecheck",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm test",
    "release:gate": "pnpm typecheck && pnpm typecheck:tests && pnpm exec vitest run test && pnpm --filter @microsonya/telegram-wma test && pnpm --filter @microsonya/cloudflare test:workers && pnpm --filter @microsonya/cloudflare types:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:json": "prettier --write \"**/*.{json,jsonc}\"",
    "format:json:check": "prettier --check \"**/*.{json,jsonc}\"",
    "start": "pnpm bot:start",
    "bot:start": "pnpm --filter @microsonya/telegram-bot start",
    "test": "vitest run",
    "test:pipeline": "cross-env MICROSONYA_PIPELINE_INTEGRATION=1 vitest run --config vitest.pipeline.config.ts",
    "test:faults": "vitest run test/reconciler-matrix.test.ts test/summary-lifecycle-storage.test.ts test/production-readiness.test.ts",
    "eval:live": "tsx test/runLiveGolden.ts",
    "bench:workers": "tsx research/bench-workers-local.ts",
    "eval:live:smoke": "tsx test/runLiveGolden.ts --suite smoke",
    "eval:live:extraction": "tsx test/runLiveGolden.ts --suite extraction",
    "eval:live:stability": "tsx test/runLiveGolden.ts --suite stability --runs 5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@types/node": "^22.15.34",
    "@types/pg": "8.20.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.7",
    "msw": "2.11.0",
    "pg": "^8.22.0",
    "prettier": "^3.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "4.127.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
