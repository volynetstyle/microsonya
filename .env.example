# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# The first production version uses process-local memory persisted as JSON.
STORAGE_MODE=memory
MEMORY_FILE_PATH=.data/memory.json

# Set to disabled to run without model calls.
MODELS_MODE=enabled

# Public URL of the Web Mini App (apps/telegram/wma). Must be https:// for
# Telegram to open it in-app; leave unset to disable the /app command. During
# local development (`pnpm dev:webapp`) this is set to the Vite dev server URL,
# which Telegram will open as a plain browser link instead.
WMA_URL=

# Local Postgres connection used by Drizzle and the bot when running outside Docker.
# If the password contains special characters, URL-encode them: # -> %23, @ -> %40.
DATABASE_URL=postgresql://microsonya:microsonya@localhost:5432/microsonya

# All model configuration below is read in exactly one place:
# packages/model-gateway/src/modelConfig.ts. Every value here documents that
# module's env vars and defaults (see that file for the source of truth).
#
# Default transport is a local native Ollama server. Point LLM_BASE_URL at
# OpenRouter or another OpenAI-compatible endpoint instead if you don't want
# to run models locally.
LLM_BASE_URL=http://localhost:11434

# How structured (schema-constrained) generation talks to the endpoint:
# ollama-native uses Ollama's own JSON mode (more reliable than its
# OpenAI-compatible json_schema translation); openai-compatible uses the
# generic client. This is explicit, not guessed from LLM_BASE_URL, so switch
# it together with LLM_BASE_URL when changing providers.
LLM_STRUCTURED_TRANSPORT=ollama-native

# Only required when LLM_BASE_URL is not a local endpoint.
# Either OPENROUTER_TOKEN or LLM_API_KEY can be used.
OPENROUTER_TOKEN=
LLM_API_KEY=

# Use one fixed segment-summary model, or leave empty to use the default.
LLM_MODEL=
LLM_MODELS=

# Model used for plain-text merges. Leave empty to reuse the primary model.
LLM_MERGE_MODEL=
LLM_MEMORY_MODEL=gpt-oss:20b-cloud

# Comma-separated models temporarily excluded from the fallback list.
LLM_QUARANTINE_MODELS=

# Optional defaults used by Docker Compose's Postgres service.
POSTGRES_DB=microsonya
POSTGRES_USER=microsonya
POSTGRES_PASSWORD=microsonya
POSTGRES_PORT=5432
