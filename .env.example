TELEGRAM_BOT_TOKEN=
# Required in production. Dev without DATABASE_URL uses in-memory storage.
DATABASE_URL=postgresql://microsonya:microsonya@localhost:5432/microsonya
# Base64-encoded 32-byte AES key. Generate once and keep it outside git.
SUMMARY_LEDGER_ENCRYPTION_KEY=
# Ollama Cloud. For a local daemon use http://localhost:11434 and leave the key empty.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
# Logs full model prompts, including chat content. Diagnostic only.
SUMMARIZATION_LOG_PROMPT=0
# Logs raw model responses, including generated chat-derived content. Diagnostic only.
SUMMARIZATION_LOG_MODEL_RESPONSE=0
