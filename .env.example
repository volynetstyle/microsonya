# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Use postgres for persistence or memory for local exploration.
STORAGE_MODE=postgres

# Set to disabled to run without model calls.
MODELS_MODE=openai-compatible

# Local Postgres connection used by Drizzle and the bot when running outside Docker.
# If the password contains special characters, URL-encode them: # -> %23, @ -> %40.
DATABASE_URL=postgresql://microsonya:microsonya@localhost:5432/microsonya

# OpenRouter is the default OpenAI-compatible provider.
# Either OPENROUTER_TOKEN or LLM_API_KEY can be used.
OPENROUTER_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Use one fixed segment-summary model, or leave empty and use the fallback list below.
LLM_MODEL=

# Ordered server-side fallback for structured segment summaries.
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-9b-v2:free,openrouter/free

# Fast model used only for plain-text merges.
LLM_MERGE_MODEL=openrouter/free
LLM_MEMORY_MODEL=gpt-oss:120b-cloud

# Comma-separated models temporarily excluded from the fallback list.
LLM_QUARANTINE_MODELS=

# Optional production router for Ollama/OpenAI-compatible endpoints.
# Routes small -> cheap, medium -> default, large -> quality and escalates on failure.
LLM_ROUTER_MODE=disabled
LLM_ROUTER_CHEAP_MODEL=gpt-oss:20b
LLM_ROUTER_DEFAULT_MODEL=qwen3.5:9b
LLM_ROUTER_QUALITY_MODEL=deepseek-v4-pro:cloud
LLM_ROUTER_DEFAULT_MIN_INPUT_TOKENS=2000
LLM_ROUTER_QUALITY_MIN_INPUT_TOKENS=12000
LLM_ROUTER_FAILURE_THRESHOLD=3
LLM_ROUTER_CIRCUIT_COOLDOWN_MS=30000

# Optional defaults used by Docker Compose's Postgres service.
POSTGRES_DB=microsonya
POSTGRES_USER=microsonya
POSTGRES_PASSWORD=microsonya
POSTGRES_PORT=5432
